# Root configuration for the BLS MCP server. Copy to `.env` in the repository
# root. The server reads `.env` from the directory it is started in, so run
# every command from the repository root. Relative paths resolve from there.

# REQUIRED. Directory holding the published DuckDB snapshot registry
# (`active-snapshot.json` plus the immutable `bls-<id>.duckdb` files). The
# server will not start until a snapshot has been published and activated
# here. QUICKSTART.md step 3 builds one offline from checked-in sample files;
# docs/bls/OPERATIONS.md covers full monthly snapshots.
BLS_SNAPSHOT_REGISTRY_DIR=./data/local/snapshots

# Local DuckDB file for saved index specifications (save_index_spec /
# get_index_spec). Created on first save. BLS series and observations are
# NOT stored here; they come from the snapshot above.
BLS_SPECS_DB_PATH=./data/local/bls_specs.duckdb

BLS_LOG_LEVEL=INFO

# The server starts on stdio unless HTTP is requested.
# Uncomment these to use `uv run --locked poe serve` + `poe smoke` locally.
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Only the manual monthly downloader (docs/bls/OPERATIONS.md) needs an
# identifying user agent. Replace with a real contact address before use.
# BLS_USER_AGENT=BLS MCP developer <you@example.com>

# A key is not needed for snapshot builds or the offline cached tools.
# Only set a REAL registration key when intentionally using the live BLS API.
# BLS_API_KEY=

# Explicitly requested mock behavior for the live-API client, if needed.
# This one is read from the process environment, not from `.env` by the
# server itself, so it only applies when uv loads this file (UV_ENV_FILE).
# MOCK_BLS_DATA=true

# Do not set PORT or DATABRICKS_APP_PORT for local stdio/8000 HTTP use.
# Those deployment environment variables force HTTP and override MCP_PORT.

# TLS behind an inspecting proxy ("invalid peer certificate: UnknownIssuer"):
# do NOT put UV_SYSTEM_CERTS / UV_NATIVE_TLS here. uv does not apply its own
# settings from a `.env` file, and `uv sync` never reads one. Set them in the
# shell or user environment instead; see QUICKSTART.md step 2.

# Ask Sage evals (see eval/asksage/README.md and eval/asksage/.env.example):
# The root .env is for BLS snapshot/transport settings, NOT Ask Sage secrets.
# Keep PORT and DATABRICKS_APP_PORT unset when running local stdio MCP evals.
# Keep MCP_TRANSPORT=stdio or leave unset for stdio; HTTP mode will hang stdio clients.

# Python executable used to launch the BLS MCP server.
# Set this to the project's virtual environment interpreter.
# MCP_PYTHON=.venv/Scripts/python.exe

UV_SYSTEM_CERTS=true
UV_NATIVE_TLS=true
NODE_USE_SYSTEM_CA=1
