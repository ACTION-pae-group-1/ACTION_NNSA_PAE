# --------------------------------------------------
# BLS Evaluation Artifacts
# --------------------------------------------------
# Preserve run.json and summary.md for reproducibility.
# Exclude detailed transcripts and runtime artifacts.

/eval/bls/results/runs/*/*

# Exclude generated JSON files directly under results.
/eval/bls/results/*.json

# --------------------------------------------------
# Ask Sage Evaluation Artifacts
# --------------------------------------------------
# Traces may contain internal catalog metadata.
# Allow aggregate CSV summaries after reviewing their contents.

/eval/asksage/results/*
!/eval/asksage/results/*.csv

# --------------------------------------------------
# Local Evaluation Environment Files
# --------------------------------------------------
/eval/bls/.env
/eval/asksage/.env

# --------------------------------------------------
# Local Phoenix Configuration
# --------------------------------------------------
# Add Phoenix-specific environment files here if needed.

# --------------------------------------------------
# Optional CAEF 2.0 demonstration assets
# --------------------------------------------------
# Re-include the packaged, signed model bundle and its inference input, which the
# global *.joblib and *.duckdb rules above would otherwise hide. Scoped to the
# demo folder only.
!src/cost_intel_app/demo_assets/caef/**/*.joblib
!src/cost_intel_app/demo_assets/caef/**/*.duckdb
# Stadium release demo package: the synthetic PARS database and the signed release bundle.
!src/cost_intel_app/demo_assets/caef_stadium/**/*.joblib
!src/cost_intel_app/demo_assets/caef_stadium/**/*.duckdb
# The demo HMAC signing secret must never be committed. Keep this rule LAST so it
# overrides the re-include lines above.
src/cost_intel_app/demo_assets/caef/demo_verification.key
