# Copy to eval/bls/.env (optional). Load explicitly with uv --env-file.
# Tracing is disabled by default and never exports prompts or tool payloads.
BLS_EVAL_PHOENIX_ENABLED=false
BLS_EVAL_PHOENIX_PROJECT=bls-mcp-evals
# Local Phoenix OTLP HTTP receiver; do not use an unapproved remote collector.
BLS_EVAL_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
