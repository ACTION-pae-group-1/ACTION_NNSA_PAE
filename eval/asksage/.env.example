# Documentation for the Ask Sage evaluation. Copy the LLM settings below into
# src/portable_llm_mcp/.env (which is ignored by git). Do not commit secrets.
# This file is NOT loaded automatically; use uv run --env-file explicitly.
LLM_PROVIDER=asksage
LLM_BASE_URL=https://api.nnsa.asksage.ai/server/openai/v1
LLM_CHAT_MODEL=gpt-5.4-gov
LLM_VISION_MODEL=gpt-5.4-gov
LLM_API_KEY=replace-with-approved-api-key
LLM_TIMEOUT_SECONDS=120
# API key must be authorized for OpenAI-compatible passthrough, including tools.
# Confirm model availability and data classification authorization independently.
# The runner uses --models for comparison, overriding LLM_CHAT_MODEL per test.
# MCP_SERVERS_FILE=eval/asksage/mcp_servers_test.json
# MCP_PYTHON must be set in PowerShell to the absolute venv python executable:
#   $env:MCP_PYTHON = (uv run python -c "import sys; print(sys.executable)")
# Avoid PORT/DATABRICKS_APP_PORT: they force the BLS launcher into HTTP mode.
# Corporate TLS: use the truststore package; do not set verify=False.
