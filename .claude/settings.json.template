{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool_call_context.py\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool_call_context.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep|NotebookEdit|TodoWrite|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool_input_preflight.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep|NotebookEdit|TodoWrite|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool_failure_recovery.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
