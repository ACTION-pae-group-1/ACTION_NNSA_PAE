# Portable LLM + MCP: current provider choices are Ollama and AskSage.
# Copy this file to .env, select ONE provider, and load environment explicitly.
# The Python package does not automatically read .env: point uv at it in each
# new terminal before `uv run`, for example (Windows CMD):
#   set "UV_ENV_FILE=src/portable_llm_mcp/.env"
# Never commit actual API keys or MCP tokens.

# CURRENT: Ollama (use the model names installed on your host)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_CHAT_MODEL=your-installed-tool-capable-model
LLM_VISION_MODEL=your-installed-vision-model
LLM_TIMEOUT_SECONDS=90
# For Python inside a Docker devcontainer with Ollama on the host, use
# LLM_BASE_URL=http://host.docker.internal:11434/v1 if reachable.

# CURRENT ALTERNATIVE: AskSage — comment out Ollama lines above first.
# API key: in AskSage, Settings > API Keys > Create Key. A key with only the
# OpenAI-compatible passthrough scope is required for /server/openai/v1;
# query-only scope is not sufficient for this endpoint.
# Host: confirm the API host for your AskSage instance with your AskSage
# administrator (the public docs only document api.asksage.ai).
# Model: use an ID your key can list (see "AskSage" in eval/bls/README.md);
# pick a tool-capable, CUI-compliant model. Model IDs change over time.
# LLM_PROVIDER=asksage
# LLM_BASE_URL=https://api.nnsa.asksage.ai/server/openai/v1
# LLM_CHAT_MODEL=your-approved-tool-capable-model
# LLM_VISION_MODEL=your-approved-vision-model
# LLM_API_KEY=replace-with-secret-from-approved-source
# Leave LLM_AUTH_HEADER unset. AskSage's OpenAI-compatible endpoint
# (/server/openai/v1) takes the API key as "Authorization: Bearer <key>",
# which is the default. x-access-tokens belongs to AskSage's native API and
# expects a separately exchanged access token, not the API key; set
# LLM_AUTH_HEADER=x-access-tokens only if your administrator says your
# instance requires it.

# MCP: local demo by default. For remote MCP, provide credentials securely.
MCP_SERVERS_FILE=src/mcp_servers.json
# MCP_INTERNAL_TOKEN=replace-with-secret-from-approved-source

# FUTURE STATE ONLY: AWS Bedrock Converse (not needed for current deployment).
# LLM_PROVIDER=bedrock
# AWS_REGION=us-gov-west-1
# LLM_CHAT_MODEL=your-approved-bedrock-model-id
# LLM_VISION_MODEL=your-approved-bedrock-vision-model-id

# Ask Sage MCP evals: see eval/asksage/README.md. On Windows enterprise TLS,
# the eval scripts use truststore to trust approved Windows CAs. Do not disable
# TLS verification. Use --env-file to load this file for uv run.
# Need to use uv run --env-file src/portable_llm_mcp/.env --with truststore --with httpx python eval/asksage/test_asksage_mcp.py
# By default, not active to avoid token waste. To run tests, uncomment below:
# RUN_LIVE_ASKSAGE_TESTS=1
